# Copy to .env (or export in your shell / CI). For the LIVE agent suite set the
# agent URL; without it, live tests skip and the offline suite still runs green.
AGENT_BASE_URL=http://localhost:8080
EVAL_THRESHOLD=0.8
AGENT_REPEAT=3
# ---------------------------------------------------------------------------
# Result import (optional). Leave blank to skip. The importer
# (scripts/import-results.js) reads these from the real environment (CI secrets
# or your shell), NOT from this file. CI's import step is gated on XRAY_CLIENT_ID,
# so it stays skipped and the build stays green until you fill these in.
# See INTEGRATIONS.md for details.
# ---------------------------------------------------------------------------

# Jira / Xray (Cloud)
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
XRAY_PROJECT_KEY=
# XRAY_TEST_PLAN_KEY=
# Jira / Xray (Server/DC): set XRAY_MODE=server and use the JIRA_* vars below
# XRAY_MODE=

# Zephyr Scale (Cloud)
ZEPHYR_API_TOKEN=
ZEPHYR_PROJECT_KEY=
# ZEPHYR_TEST_CYCLE_KEY=

# TestRail
TESTRAIL_URL=
TESTRAIL_USER=
TESTRAIL_API_KEY=
TESTRAIL_PROJECT_ID=
# TESTRAIL_SUITE_ID=
# TESTRAIL_SECTION_ID=   # required only for --create-missing

# Jira (open defects for failures; also Xray Server auth)
JIRA_BASE_URL=
JIRA_USER=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# JIRA_PAT=
