<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  CI suite - runs EVERYTHING in one pass (UI regression + offline agent logic +
  LIVE agent tests), because CI starts the reference agent first. Used by the
  GitHub Actions workflow:
    mvn test -Dsurefire.suiteXmlFiles=testng-ci.xml -Dagent.base.url=http://localhost:8080
-->
<suite name="CI" parallel="methods" thread-count="3">
    <test name="RegressionTests">
        <classes>
            <class name="com.example.tests.LoginTest"/>
            <class name="com.example.tests.InventoryTest"/>
        </classes>
    </test>
    <test name="AgentWorkflows">
        <classes>
            <class name="com.example.agent.EvaluatorTest"/>
            <class name="com.example.agent.DataQualityTest"/>
            <class name="com.example.agent.GuardrailTest"/>
            <class name="com.example.agent.AgentMockingTest"/>
            <class name="com.example.agent.AgentApiUiWorkflowTest"/>
            <class name="com.example.agent.AgentEvalHarnessTest"/>
            <class name="com.example.agent.AgentNonDeterminismTest"/>
            <class name="com.example.agent.AgentGuardrailLiveTest"/>
        </classes>
    </test>
</suite>
